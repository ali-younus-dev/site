# =====================================================================
#  Fotile Pakistan — .htaccess
#  Clean URLs + complete WordPress -> static 301 migration map.
#  Everything uses mod_rewrite (not mod_alias Redirect) so rule order is
#  deterministic: mod_rewrite always runs before mod_alias, and mixing the
#  two silently changes which rule wins.
# =====================================================================

Options +FollowSymLinks
RewriteEngine On
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# 0. CANONICAL HOST — https + non-www, in ONE hop.
#    Every canonical tag on the site is https://fotilepk.com (no www),
#    so anything else must land here or link equity splits four ways.
#    Combined into a single rule so http://www -> https://non-www is one
#    redirect, not two.
# ---------------------------------------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://fotilepk.com/$1 [R=301,L]

# ---------------------------------------------------------------------
# 1. WORDPRESS SYSTEM PATHS — kill the crawl traps before anything else.
# ---------------------------------------------------------------------
# Internal search -> shop
RewriteCond %{QUERY_STRING} (^|&)s= [NC]
RewriteRule ^/?$ /shop/? [R=301,L]
# ?p=123 / ?page_id=123 permalinks -> home
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|tag|m)= [NC]
RewriteRule ^/?$ /? [R=301,L]
# add-to-cart / orderby / filter query junk -> clean the query off
RewriteCond %{QUERY_STRING} (^|&)(add-to-cart|orderby|filtering|filter_|min_price|max_price|product_count|really_curr_tax|wc-ajax)= [NC]
RewriteRule ^(.*)$ /$1? [R=301,L]
# feeds, API, trackbacks, author archive, attachment pages, paged home
RewriteRule ^feed/?$                      /blog/ [R=301,L]
RewriteRule ^comments/feed/?$             /blog/ [R=301,L]
RewriteRule ^(.+)/feed/?$                 /blog/ [R=301,L]
RewriteRule ^(.+)/trackback/?$            /blog/ [R=301,L]
RewriteRule ^author/[^/]+/?$              /blog/ [R=301,L]
RewriteRule ^page/[0-9]+/?$               / [R=301,L]
RewriteRule ^wp-json(/.*)?$               / [R=301,L]
RewriteRule ^xmlrpc\.php$                 / [R=301,L]
RewriteRule ^wp-login\.php$               / [R=301,L]
RewriteRule ^wp-admin(/.*)?$              / [R=301,L]

# ---------------------------------------------------------------------
# 2. WORDPRESS PAGES that no longer exist
# ---------------------------------------------------------------------
RewriteRule ^home-regular/?$ / [R=301,L]
RewriteRule ^fotile-shop/?$ /shop/ [R=301,L]
RewriteRule ^my-account-2/?$ /contact-us/ [R=301,L]
RewriteRule ^my-account/?$ /contact-us/ [R=301,L]
RewriteRule ^track-your-order/?$ /service-center/ [R=301,L]
RewriteRule ^yith-compare/?$ /shop/ [R=301,L]
RewriteRule ^compare/?$ /shop/ [R=301,L]
RewriteRule ^wishlist/?$ /shop/ [R=301,L]
RewriteRule ^mega-sale/?$ /shop/ [R=301,L]

# ---------------------------------------------------------------------
