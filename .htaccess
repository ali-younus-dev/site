# anything else under /product-tag/ -> shop
RewriteRule ^product-tag/.*$ /shop/ [R=301,L]

# ---------------------------------------------------------------------
# 7. LEGACY FLAT .html PREVIEW FILES -> clean URLs (single hop each)
# ---------------------------------------------------------------------
RewriteRule ^about\.html$ /about-us/ [R=301,L]
RewriteRule ^contact\.html$ /contact-us/ [R=301,L]
RewriteRule ^dealers\.html$ /our-dealers/ [R=301,L]
RewriteRule ^moon-series\.html$ /moon-series/ [R=301,L]
RewriteRule ^shop\.html$ /shop/ [R=301,L]
RewriteRule ^cart\.html$ /cart/ [R=301,L]
RewriteRule ^payment\.html$ /cart/ [R=301,L]
RewriteRule ^blog\.html$ /blog/ [R=301,L]
RewriteRule ^blog2\.html$ /blog/page/2/ [R=301,L]
RewriteRule ^blog3\.html$ /blog/page/3/ [R=301,L]
RewriteRule ^blog-post\.html$ /blog/ [R=301,L]
RewriteRule ^explore\.html$ /shop/ [R=301,L]
RewriteRule ^masterpiece\.html$ / [R=301,L]
RewriteRule ^masterpiece-cinematic\.html$ / [R=301,L]
RewriteRule ^privacy-policy\.html$ /privacy-policy/ [R=301,L]
RewriteRule ^refund-policy\.html$ /refund_returns/ [R=301,L]
RewriteRule ^shipping-policy\.html$ /shipping-policy/ [R=301,L]
