# ---------------------------------------------------------------------
# 8. INTERNAL TIDY-UPS
# ---------------------------------------------------------------------
RewriteRule ^white-series/?$  /opal-series/ [R=301,L]
RewriteRule ^experience/?$    / [R=301,L]
RewriteRule ^checkout/?$      /cart/ [R=301,L]
RewriteRule ^home-regular-old/?$ / [R=301,L]
# stale local build folders must never resolve in production
RewriteRule ^fridge/(fridge|tttt)/?.*$ /fridge/ [R=301,L]
RewriteRule ^moon-series/moonseries.*$ /moon-series/ [R=301,L]

# ---------------------------------------------------------------------
# 8b. SERVE WEBP SILENTLY (mobile speed — Core Web Vitals)
#     If the browser accepts WebP and a "<image>.png.webp" sits next to the
#     requested .png/.jpg, send the WebP instead. Same URL, no markup change,
#     the dashboard keeps uploading PNG/JPG as before. Product photos drop
#     from ~16 MB to ~2 MB. An image without a .webp twin is served as-is.
# ---------------------------------------------------------------------
AddType image/webp .webp
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{REQUEST_FILENAME}.webp -f
RewriteRule ^(.+\.(?:png|jpe?g))$ $1.webp [T=image/webp,L]
<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|webp)$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# 9. BLOCK ADMIN SURFACES (defence in depth — these should not be deployed)
# ---------------------------------------------------------------------
<FilesMatch "^(dashboard|dashboard-demo|dashboard-local|admin-api)\.(html|php)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/\.admin-backups
RedirectMatch 404 ^/\.git

# ---------------------------------------------------------------------
# 10. PERFORMANCE — Core Web Vitals feed ranking
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/manifest+json image/svg+xml image/x-icon
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # CSS/JS file names never change, so a 1-year cache would hide every fix
  # from returning visitors for a year. 7 days balances speed and freshness.
  ExpiresByType text/css            "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript    "access plus 7 days"
  ExpiresByType application/manifest+json "access plus 7 days"
  ExpiresByType image/x-icon        "access plus 1 year"
  ExpiresByType image/webp          "access plus 1 year"
  ExpiresByType image/jpeg          "access plus 1 year"
  ExpiresByType image/png           "access plus 1 year"
  ExpiresByType image/svg+xml       "access plus 1 year"
  ExpiresByType font/woff2          "access plus 1 year"
  ExpiresByType video/mp4           "access plus 1 year"
  ExpiresByType text/html           "access plus 10 minutes"
</IfModule>
# Dashboard-edited data (products, blog, news) must show up within minutes.
<FilesMatch "-data(-\d+)?\.js$">
  <IfModule mod_expires.c>
    ExpiresByType application/javascript "access plus 5 minutes"
    ExpiresByType text/javascript "access plus 5 minutes"
  </IfModule>
</FilesMatch>
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

