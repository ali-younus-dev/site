RewriteRule ^category-hoods\.html$ /product-category/kitchen-hood/ [R=301,L]
RewriteRule ^category-hobs\.html$ /product-category/hobs/ [R=301,L]
RewriteRule ^category-ovens\.html$ /product-category/oven/ [R=301,L]
RewriteRule ^category-microwaves\.html$ /product-category/oven/microwave-oven-prices-in-pakistan/ [R=301,L]
